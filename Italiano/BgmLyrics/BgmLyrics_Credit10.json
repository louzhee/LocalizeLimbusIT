{
  "dataList": [
    {
      "id": "0",
      "content": "<color=#293B95>Dei giorni passati ad inseguire ombre</color>"
    },
    {
      "id": "1",
      "content": "<color=#293B95>Restano solo ricordi vani</color>"
    },
    {
      "id": "2",
      "content": "<color=#293B95>Come se il fuoco mi avvolgesse</color>"
    },
    {
      "id": "3",
      "content": "<color=#293B95>In mano mi resta solo polvere di cenere</color>"
    },
    {
      "id": "4",
      "content": "<color=#293B95>Ho corso senza riposarmi</color>"
    },
    {
      "id": "5",
      "content": "<color=#293B95>Quei momenti che mi hanno soffocato</color>"
    },
    {
      "id": "6",
      "content": "<color=#293B95>Mancheranno anche a mei?</color>"
    },
    {
      "id": "7",
      "content": "<color=#293B95>Tra molto, molto tempo</color>"
    },
    {
      "id": "8",
      "content": "<color=#293B95>Quando ripenserò a quei ricordi,</color>"
    },
    {
      "id": "9",
      "content": "<color=#293B95>Spero di poter sorridere</color>"
    },
    {
      "id": "10",
      "content": "<color=#293B95>Con quel il tempo che mi resta</color>"
    },
    {
      "id": "11",
      "content": "<color=#293B95>Adesso devo andare avanti</color>"
    },
    {
      "id": "12",
      "content": "<color=#293B95>Bruciando fino a consumarmi</color>"
    },
    {
      "id": "13",
      "content": "<color=#293B95>Come una candela che si consuma</color>"
    },
    {
      "id": "14",
      "content": "<color=#293B95>Senza un momento per respirare</color>"
    },
    {
      "id": "15",
      "content": "<color=#293B95>Mi sono trovato in giorni turbolenti</color>"
    },
    {
      "id": "16",
      "content": "<color=#293B95>Spero di poter andare per la mia strada</color>"
    },
    {
      "id": "17",
      "content": "<color=#293B95>Tra molto, molto tempo</color>"
    },
    {
      "id": "18",
      "content": "<color=#293B95>Quando ripenserò a quei ricordi</color>"
    },
    {
      "id": "19",
      "content": "<color=#293B95>Vorrei tanto poter sorridere</color>"
    },
    {
      "id": "20",
      "content": "<color=#293B95>Fammi, fammi volare così lontano</color>"
    },
    {
      "id": "21",
      "content": "<color=#293B95>"Così da raggiungere le stelle, come un'uccello nella notte</color>"
    },
    {
      "id": "22",
      "content": "<color=#293B95>Questa notte, questa notte tornerà certamente, ma……</color>"
    },
    {
      "id": "23",
      "content": "<color=#293B95>Va tutto bene, perché io vivrò</color>"
    },
    {
      "id": "24",
      "content": "<color=#293B95>Va tutto bene</color>"
    }
  ]
}

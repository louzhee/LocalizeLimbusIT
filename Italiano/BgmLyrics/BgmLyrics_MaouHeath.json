    {
      "id": 0,
      "content": "<style=\"den_CP6_2\">Come ho desiderato un altro",
      "vocalid": 0
    },
    {
      "id": 1,
      "content": "<style=\"den_CP6_2\">Futuro più felice, più luminoso",
      "vocalid": 0
    },
    {
      "id": 2,
      "content": "<style=\"den_CP6_2\">Ed eccomi qui, davanti al cancello",
      "vocalid": 0
    },
    {
      "id": 3,
      "content": "<style=\"den_CP6_2\">Cari vecchi tempi",
      "vocalid": 0
    },
    {
      "id": 4,
      "content": "<style=\"den_CP6_2\">Ho preso una decisione",
      "vocalid": 0
    },
    {
      "id": 5,
      "content": "<style=\"den_CP6_2\">Quanto devi aver sofferto a causa della mia rabbia",
      "vocalid": 0
    },
    {
      "id": 6,
      "content": "<style=\"den_CP6_2\">Il mio contegno, così volgare e imbarazzante",
      "vocalid": 0
    },
    {
      "id": 7,
      "content": "Quanto devi aver sottovalutato i tuoi pregi",
      "vocalid": 1
    },
    {
      "id": 8,
      "content": "Il tuo garbo, diretto e sincero",
      "vocalid": 1
    },
    {
      "id": 9,
      "content": "<style=\"den_CP6_2\">Eccoci qui, alla terra del destino",
      "vocalid": 0
    },
    {
      "id": 10,
      "content": "<style=\"den_CP6_2\">Farò in modo che smetta di esistere",
      "vocalid": 0
    },
    {
      "id": 11,
      "content": "Mi guarderai smettere di esistere?",
      "vocalid": 1
    },
    {
      "id": 12,
      "content": "<style=\"den_CP6_2\">Oh",
      "vocalid": 0
    },
    {
      "id": 13,
      "content": "<style=\"den_CP6_2\">Giriamo in tondo",
      "vocalid": 0
    },
    {
      "id": 14,
      "content": "<style=\"den_CP6_2\">Aggrappandoci al dolore",
      "vocalid": 0
    },
    {
      "id": 15,
      "content": "<style=\"den_CP6_2\">Guidati dal nostro ego,",
      "vocalid": 0
    },
    {
      "id": 16,
      "content": "<style=\"den_CP6_2\">Sentimenti mai espressi",
      "vocalid": 0
    },
    {
      "id": 17,
      "content": "<style=\"den_CP6_2\">Tessendo le nostre versioni del passato",
      "vocalid": 0
    },
    {
      "id": 18,
      "content": "<style=\"den_CP6_2\">Che non immagineresti mai",
      "vocalid": 0
    },
    {
      "id": 19,
      "content": "<style=\"den_CP6_2\">Perché io lo so",
      "vocalid": 0
    },
    {
      "id": 20,
      "content": "<style=\"den_CP6_2\">Devo essere io il motivo per cui",
      "vocalid": 0
    },
    {
      "id": 21,
      "content": "<style=\"den_CP6_2\">Hai smesso di sorridere",
      "vocalid": 0
    },
    {
      "id": 22,
      "content": "<style=\"den_CP6_2\">E la speranza nei tuoi occhi è stata rubata",
      "vocalid": 0
    },
    {
      "id": 23,
      "content": "<style=\"den_CP6_2\">Devo essere io il motivo per cui",
      "vocalid": 0
    },
    {
      "id": 24,
      "content": "<style=\"den_CP6_2\">Devi dirmi tutte quelle bugie",
      "vocalid": 0
    },
    {
      "id": 25,
      "content": "<style=\"den_CP6_2\">Ti auguro una vita migliore senza me al tuo fianco",
      "vocalid": 0
    },
    {
      "id": 26,
      "content": "<style=\"den_CP6_2\">Questo messaggio è già stato detto, tra macchie viola",
      "vocalid": 0
    },
    {
